use $sys.calls.*;

## Metallic plates falling from the sky relative to spawned blue cubes.

def on_update(ctx: Struct, ent: Uns64, data: Struct, ...) {
    let step: UnsF = ctx.tick_count

    ## Load configuration data from the context struct
    let fall_distance: RealF = data.fall_distance
    let delay: RealF = data.delay
    let lifetime: Tuple = data.lifetime
    let restitution: RealF = data.restitution

    ## Calculate spawn position (x, y, z)
    let x: RealF = ent % 11 - 5.0
    let z: RealF = ent % 13 - 5.0
    let y: RealF = (ent % 3) + fall_distance

    let pos = [:, x, y, z]

    ## Make a color.
    let rr = x + step
    let r = rr / 11.0 % 5.0

    let gg = z + step
    let g = gg / 11.0 % 5.0

    let bb = step - 17.0
    let b = z / 13.0 % 5.0

    let hue = step % 360.0
    let color_enum = ['Hsva', hue, 'saturation', 0.75, 'value', r]

    let rot_x = step % 45.0
    let angle = ['Deg', [y: rot_x, x: 0, z: 0]]

    let mesh_mat = [
        mesh: "models/tile.glb#Mesh0/Primitive0",
        material: "models/tile.glb#Material0/std",
    ]
    let shape = ['MeshMaterial', mesh_mat]
    let collider_shape = ['Cube', 'x', 1.0, 'y', 0.025, 'z', 1.0]

    let rest = ['coefficient', restitution, 'combine_rule', 'Average']

    let new_entity = bevy_call_func('spawn_entity',
        'Name', "TILE",
        'Cube', nil,
        'swept_ccd', 'linear',
        'relative_to', ent,
        'offset', pos,
        'rotation', angle,
        'scale', 0.5,
        'color', color_enum,
        'rigid_body', 'Dynamic',
        'shape', shape,
        'collider_shape', collider_shape,
        'friction', 0.9,
        'Restitution', rest,
        'mass', 10.0,
        'CrosshairTargetable', nil,
        'SurfaceMaterial', 'Metal',
        'Projectile', nil,
        'despawn_after', lifetime,
        'swept_ccd', 'linear',
    )

    ## Package ScriptCreationInfo data
    let sci = [
        path: 'scripts/cube_handler.das',
        mode: 'Async',
    ]
    bevy_call_func(new_entity, 'add_script', sci)

    $sys.calls.delay(delay)
}

[
    'block_size': 0.375,
    'side_length': 3,
    'on_update': on_update,
    'boom_mass': 500.0,
    'block_mass': 50.0,
    'static': false,
    'center_pos': [x: 6.0, y: 5.0, z: -5.0],
    'block_data': [
        'fall_distance': 5.0,
        'delay': 10.0,
        'restitution': 0.2,
        'lifetime': ['Temporary', 'secs', 60],
    ],
]
